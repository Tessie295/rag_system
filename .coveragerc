[run]
source = app
omit = 
    */site-packages/*
    */tests/*
    */env/*
    */venv/*

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise NotImplementedError
    if __name__ == .__main__.:
    pass
    raise ImportError
    except ImportError
    raise AssertionError

show_missing = True